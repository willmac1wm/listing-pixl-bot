# Copy to .env and fill in REAL values. Never commit .env.
# All values below are PLACEHOLDERS — not real credentials or numbers.
# (Voice bot shares the SMS bot's env vars; this file lists the
# voice-specific ones. One .env serves the whole server.)

# Telnyx API key (Mission Control > API Keys). Required to answer calls
# and send SMS. On Legion the live key is in C:\ai-comms-service\.env.
TELNYX_API_KEY=

# The Telnyx number the bot answers/texts from, E.164 (buy one first).
TELNYX_BOT_NUMBER=+16095550127

# William's cell — lead summaries are texted here.
WILLIAM_CELL=+16097807027

# Assistant id from create_assistant.py (assistant-<uuid>). Empty until
# the assistant is created at launch (blocked today: trial account 403).
TELNYX_ASSISTANT_ID=

# Telnyx Ultra voice UUID override (Telnyx.Ultra.<uuid> for Clara).
# Leave empty to use the voice in assistant_config.json.
TELNYX_VOICE_ID=

# Telnyx webhook public key (Mission Control > Keys & Credentials >
# Public Key), base64 Ed25519. Optional for local testing; REQUIRED
# in production — without it, unsigned webhooks are accepted.
TELNYX_PUBLIC_KEY=

# true = answer with the AI assistant; false = IVR fallback
# (plain Call Control TTS + gather). Default true.
USE_VOICE_AI=true

# Public base URL of this server (no trailing slash).
PUBLIC_BASE_URL=https://bot.listingpixl.com

# Where voice call/lead JSON is stored (relative or absolute).
DATA_DIR=./data

LOG_LEVEL=INFO
