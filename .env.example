# Copy to .env and fill in REAL values. Never commit .env.
# All values below are PLACEHOLDERS — not real credentials or numbers.

# Telnyx API key (Mission Control > API Keys). Required to send SMS.
TELNYX_API_KEY=YOUR_TELNYX_API_KEY_HERE

# The Telnyx number the bot texts from, E.164 (buy one in Telnyx first).
TELNYX_BOT_NUMBER=+16095550127

# William's cell — lead summaries and escalation flags are texted here.
WILLIAM_CELL=+16097807027

# Public base URL of this server (no trailing slash). Used for the
# webhook URL you paste into the Telnyx messaging profile.
PUBLIC_BASE_URL=https://example.com

# Telnyx webhook public key (Mission Control > Keys & Credentials >
# Public Key), base64 Ed25519. Optional for local testing; REQUIRED
# in production — without it, unsigned webhooks are accepted.
TELNYX_PUBLIC_KEY=

# Assistant id from voice/create_assistant.py (assistant-<uuid>).
# Empty until the assistant is created at launch (blocked today:
# trial account 403 — see LAUNCH.md).
TELNYX_ASSISTANT_ID=

# Telnyx Ultra voice UUID override (Telnyx.Ultra.<uuid> for Clara).
# Leave empty to use the voice in voice/assistant_config.json.
TELNYX_VOICE_ID=

# true = answer calls with the AI assistant; false = IVR fallback
# (plain Call Control TTS + gather). Default true.
USE_VOICE_AI=true

# Where lead/conversation JSON is stored (relative or absolute).
DATA_DIR=./data

LOG_LEVEL=INFO
